# VERITAS — environment variables
#
# Copy this file as .env and put in your own value:
#   cp .env.example .env
#
# The .env file is listed in .gitignore and NEVER reaches GitHub.

# Tavily key (https://tavily.com → API Key). Enables live search.
# Without a key the app honestly runs in demo mode on the synthetic archive.
TAVILY_API_KEY=tvly-PASTE_YOUR_KEY_HERE

# Live-mode server port (default 8787)
# PORT=8787

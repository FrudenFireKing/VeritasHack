# VERITAS — environment variables
#
# Copy this file as .env and put in your own value:
#   cp .env.example .env
#
# The .env file is listed in .gitignore and NEVER reaches GitHub.
# Nothing below is mandatory: with zero keys the app runs honestly
# in Demo Archive mode.

# ── Tavily Search (https://tavily.com → API Key) ─────────────────────
# Enables LIVE mode: dated web evidence for every claim.
TAVILY_API_KEY=tvly-

# ── Bifrost gateway (track requirement, https://github.com/maximhq/bifrost) ──
# The LLM assessor is routed through Bifrost by Maxim AI — the open-source AI
# gateway required by the track text. Bifrost exposes an OpenAI-compatible API,
# so the only change is the base URL (default gateway port is 8080):
#   bifrost gateway          → serves http://localhost:8080/v1/chat/completions
BIFROST_BASE_URL=http://127.0.0.1:8080/v1
BIFROST_API_KEY=
BIFROST_MODEL=groq/llama-3.3-70b-versatile

# ── Legacy assessor variables (still honoured) ───────────────────────
# If BIFROST_BASE_URL is unset, the assessor falls back to any direct
# OpenAI-compatible endpoint. Free examples:
#   Groq:       https://api.groq.com/openai/v1       (llama-3.3-70b-versatile)
#   OpenRouter: https://openrouter.ai/api/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=gsk_
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Live-mode server port (default 8787)
PORT=8787
